{
  "manifest_version": 3,
  "name": "Smart Bookmark Manager",
  "version": "0.2.0",
  "description": "Tag, group and search your bookmarks. Syncs with your own self-hosted server.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "bookmarks", "contextMenus", "activeTab", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": {
    "default_title": "Bookmark this page",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B", "mac": "Alt+Shift+B" },
      "description": "Bookmark this page"
    }
  },
  "options_page": "options/options.html"
}
